# ─────────────────────────────────────────────────────────────────────────────
# Cursus — variables d'environnement
#
# Copier ce fichier en `.env` (ne JAMAIS le committer) et remplir avec les vraies
# valeurs récupérées depuis le tableau de bord Supabase et Resend.
#
# Sur Vercel : déclarer ces mêmes variables dans
#   Project Settings  →  Environment Variables
# Seules celles préfixées par VITE_ sont injectées dans le bundle client.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — client (exposé au navigateur, en lecture-seule via RLS)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Application
VITE_APP_NAME=Cursus
VITE_APP_URL=https://cursus.dz
VITE_DEFAULT_LANG=fr        # fr | en | ar
VITE_DEFAULT_THEME=light    # light | dark

# ─── Variables côté serveur uniquement (Supabase Edge Function) ──────────────
# Ne PAS préfixer par VITE_  →  jamais bundlées dans le client.

# Service role key — utilisée uniquement par l'Edge Function (envoi d'email
# administratif). À déclarer dans Supabase → Project Settings → Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — service d'envoi d'email transactionnel
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=documents@cursus.dz
RESEND_FROM_NAME=Cursus
