# ─────────────────────────────────────────────────────────────────────────────
#  Cursus — variables d'environnement
#
#  En production, définissez-les dans le tableau de bord de l'hébergeur
#  (Vercel → Settings → Environment Variables). Ne versionnez jamais ce
#  fichier rempli.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données (obligatoire) ────────────────────────────────────────────
# Toute base PostgreSQL 14+ convient : Neon, Vercel Postgres, Railway, Render,
# ou une instance auto-hébergée. Le schéma n'utilise aucune extension exotique.
DATABASE_URL=postgres://utilisateur:motdepasse@hote/base?sslmode=require

# ── Secret de signature des sessions (obligatoire) ───────────────────────────
# 32 caractères minimum. À générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Le changer déconnecte immédiatement toutes les sessions en cours.
AUTH_SECRET=

# ── Optionnel ────────────────────────────────────────────────────────────────
# Port du serveur d'API en développement (npm run dev:api)
API_PORT=3001

# Taille du pool de connexions PostgreSQL par instance de fonction.
# Sur une base serverless (Neon), garder une valeur basse.
PG_POOL_MAX=5

# Rôle PostgreSQL sous lequel s'exécutent les requêtes utilisateur.
# Il ne doit surtout pas être propriétaire des tables, sinon RLS est contournée.
PG_APP_ROLE=app_authenticated

# Langue et thème par défaut de l'interface
VITE_DEFAULT_LANG=fr
VITE_DEFAULT_THEME=light
